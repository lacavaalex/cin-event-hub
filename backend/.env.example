# ── Banco de dados ──────────────────────────────────────────────────
# SQLite local (padrão enquanto o PostgreSQL não está pronto)
# Para PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/eventos
DATABASE_URL=sqlite:///./eventos.db

# ── JWT ─────────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Admin seed (primeiro admin criado automaticamente) ──────────────
ADMIN_EMAIL=admin@cin.ufpe.br
ADMIN_PASSWORD=123456
