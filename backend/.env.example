# ── Banco de dados ──────────────────────────────────────────────────
# PostgreSQL (dev, testes e produção). Preencha DATABASE_URL somente no .env privado.
# Crie o banco, rode database/001_schema.sql
# e só depois suba o backend. Passo a passo: docs/migracao-postgresql.md
DATABASE_URL=

# ── JWT ─────────────────────────────────────────────────────────────
# Obrigatório: defina uma chave forte de 64 caracteres hexadecimais.
# Gere localmente: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Opcional: alias com precedência sobre SECRET_KEY, se definido no ambiente
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Admin seed (primeiro admin criado automaticamente) ──────────────
# Gravado na tabela usuario com is_admin = TRUE (não há tabela própria de admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_PROFILE_NAME=admin

# ── Extração de e-mails ────────────────────────────────────
# Liga/desliga o job agendado e o intervalo entre varreduras.
EXTRACTION_ENABLED=true
EXTRACTION_INTERVAL_MINUTES=720
# Credenciais OAuth 2.0 do Gmail (client_secret do GCP, formato "Desktop app")
# e token gerado após a primeira autorização. Ficam apenas no servidor.
GMAIL_CREDENTIALS_FILE=./gmail_credentials.json
GMAIL_TOKEN_FILE=./gmail_token.json
# Query da Gmail API — filtra a varredura (ex.: domínio institucional).
GMAIL_QUERY=newer_than:7d
GMAIL_MAX_RESULTS=50

# Chave do Google AI Studio (fica apenas no servidor — DoD D7).
# Sem a chave, o fallback de IA fica desligado e o e-mail sem dados vira "ignorado"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=1024

# ── Limpeza de eventos expirados (US 5.1 / 5.2) ──────────────
# Liga/desliga a rotina de expiração autônoma.
CLEANUP_ENABLED=true
# Horário de execução diária (CRON) no fuso America/Recife (padrão: 03:00)
CLEANUP_CRON_HOUR=3
CLEANUP_CRON_MINUTE=0
# Opcional: define intervalo em minutos em vez de CRON diário (útil para dev/testes)
# CLEANUP_INTERVAL_MINUTES=60

