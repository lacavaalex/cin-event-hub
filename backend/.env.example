# ── Banco de dados ──────────────────────────────────────────────────
# PostgreSQL (dev, testes e produção). Crie o banco, rode database/001_schema.sql
# e só depois suba o backend. Passo a passo: docs/migracao-postgresql.md
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/eventos

# ── JWT ─────────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Admin seed (primeiro admin criado automaticamente) ──────────────
ADMIN_EMAIL=admin@cin.ufpe.br
ADMIN_PASSWORD=123456

# ── Extração de e-mails ────────────────────────────────────
# Liga/desliga o job agendado e o intervalo entre varreduras.
EXTRACTION_ENABLED=true
EXTRACTION_INTERVAL_MINUTES=15
# Credenciais OAuth 2.0 do Gmail (client_secret do GCP, formato "Desktop app")
# e token gerado após a primeira autorização. Ficam apenas no servidor.
GMAIL_CREDENTIALS_FILE=./gmail_credentials.json
GMAIL_TOKEN_FILE=./gmail_token.json
# Query da Gmail API — filtra a varredura (ex.: domínio institucional).
GMAIL_QUERY=newer_than:7d
GMAIL_MAX_RESULTS=50
